{
  "name": "@deepfamily/protocol-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "files": [
    "*.js",
    "*.d.ts",
    "UNICODE-LICENSE.txt"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:receive-security": "node --test test/shielded-receive-encryption*.test.js test/shielded-receive-wasm.test.js test/shielded-letters.test.js"
  },
  "dependencies": {
    "@hpke/core": "1.9.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "1.2.6",
    "ethers": "6.17.0",
    "ffjavascript": "0.3.1",
    "fflate": "0.8.3",
    "hash-wasm": "4.12.0",
    "libsodium-sumo": "0.8.4",
    "poseidon-lite": "0.3.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
