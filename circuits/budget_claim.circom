pragma circom 2.2.3;

include "budget_common.circom";

// Consume one contribution, release one mature policy period and preserve the
// budget record's original time rights in the remaining contribution. Period
// authority is the canonical subject secret, never the receive-code alias.
template Claim() {
    signal input chainId;
    signal input pool;
    signal input codeAlias;
    signal input nonce;
    signal input ownerCommitment;
    signal input viewKeyLo;
    signal input viewKeyHi;
    signal input policyCommitment;
    signal input budgetKey;
    signal input eligibleFrom;
    signal input asOf;
    signal input inputRoot;
    signal input inputNullifier;
    signal input periodNullifier;
    signal input outputCommitments[2];
    signal input ciphertextHashes[2];
    signal input authorizerScope;
    signal input issuanceRoot;
    signal input childRoleIndex;
    signal input endorsementRoleIndex;
    signal input trustedRoleIndex;

    signal input derivedSecretField;
    signal input codeSecret;
    signal input ownerSecret;
    signal input familyCommitment;
    signal input parentVersion;
    signal input rate;
    signal input periodDays;
    signal input policySalt;
    signal input allocationKeyCommitment;
    signal input remaining;
    signal input remainingPeriods;
    signal input budgetNonce;
    signal input budgetCiphertextHash;
    signal input noteDepth;
    signal input noteIndex;
    signal input noteSiblings[32];
    signal input periodIndex;
    signal input outputBudgetNonce;
    signal input valueNonce;
    // The recipient is online when claiming. Prove current qualification with
    // a known credential; code expiry only governs new acceptance.
    signal input issueNonce;
    signal input endorser;
    signal input xChild;
    signal input xEndorse;
    signal input xTrust;
    signal input credentialSalt;
    signal input credentialDepth;
    signal input credentialIndex;
    signal input credentialSiblings[32];

    component scope = ShieldedPoolDomain();
    scope.chainId <== chainId;
    scope.pool <== pool;
    component alias = Poseidon(4);
    alias.inputs[0] <== 73103;
    alias.inputs[1] <== derivedSecretField;
    alias.inputs[2] <== nonce;
    alias.inputs[3] <== codeSecret;
    codeAlias === alias.out;
    component owner = Poseidon(2);
    owner.inputs[0] <== 1013;
    owner.inputs[1] <== ownerSecret;
    ownerCommitment === owner.out;
    component policy = ShieldedPrivatePolicy();
    policy.poolDomain <== scope.domain;
    policy.rootIdentityCommitment <== familyCommitment;
    policy.rootVersionIndex <== parentVersion;
    policy.rate <== rate;
    policy.periodDays <== periodDays;
    policy.policySalt <== policySalt;
    policy.allocationKeyCommitment <== allocationKeyCommitment;
    policyCommitment === policy.commitment;
    component credential = CredentialCommitment();
    credential.chainId <== chainId;
    credential.authorizerScope <== authorizerScope;
    credential.derivedSecretField <== derivedSecretField;
    credential.issueNonce <== issueNonce;
    credential.familyRoot <== familyCommitment;
    credential.endorser <== endorser;
    credential.parentVersion <== parentVersion;
    credential.xChild <== xChild;
    credential.xEndorse <== xEndorse;
    credential.xTrust <== xTrust;
    credential.credentialSalt <== credentialSalt;
    component qualification = ShieldedMerkleRoot(32);
    qualification.leaf <== credential.credentialCommitment;
    qualification.depth <== credentialDepth;
    qualification.index <== credentialIndex;
    qualification.siblings <== credentialSiblings;
    qualification.out === issuanceRoot;
    component childRole = Poseidon(2);
    childRole.inputs[0] <== 74321;
    childRole.inputs[1] <== xChild;
    childRoleIndex === childRole.out;
    component endorsementRole = Poseidon(2);
    endorsementRole.inputs[0] <== 74322;
    endorsementRole.inputs[1] <== xEndorse;
    endorsementRoleIndex === endorsementRole.out;
    component trustedRole = Poseidon(2);
    trustedRole.inputs[0] <== 74323;
    trustedRole.inputs[1] <== xTrust;
    trustedRoleIndex === trustedRole.out;
    component key = BudgetKey();
    key.poolDomain <== scope.domain;
    key.codeAlias <== codeAlias;
    key.policyCommitment <== policyCommitment;
    budgetKey === key.key;
    component periodsBits = Num2Bits(64);
    periodsBits.in <== remainingPeriods;
    component periodsNZ = NonZero();
    periodsNZ.in <== remainingPeriods;
    remaining === rate * remainingPeriods;
    component oldBudget = BudgetNote();
    oldBudget.poolDomain <== scope.domain;
    oldBudget.policyCommitment <== policyCommitment;
    oldBudget.budgetKey <== budgetKey;
    oldBudget.ownerCommitment <== ownerCommitment;
    oldBudget.viewKeyLo <== viewKeyLo;
    oldBudget.viewKeyHi <== viewKeyHi;
    oldBudget.eligibleFrom <== eligibleFrom;
    oldBudget.rate <== rate;
    oldBudget.remaining <== remaining;
    oldBudget.nonce <== budgetNonce;
    oldBudget.ciphertextHash <== budgetCiphertextHash;
    component membership = ShieldedMerkleRoot(32);
    membership.leaf <== oldBudget.commitment;
    membership.depth <== noteDepth;
    membership.index <== noteIndex;
    membership.siblings <== noteSiblings;
    membership.out === inputRoot;
    component spendTag = ShieldedScopedTag();
    spendTag.poolDomain <== scope.domain;
    spendTag.purpose <== 1016;
    component spend = Poseidon(3);
    spend.inputs[0] <== spendTag.tag;
    spend.inputs[1] <== ownerSecret;
    spend.inputs[2] <== oldBudget.commitment;
    inputNullifier === spend.out;
    component periodTag = ShieldedScopedTag();
    periodTag.poolDomain <== scope.domain;
    periodTag.purpose <== 1017;
    component period = Poseidon(4);
    period.inputs[0] <== periodTag.tag;
    period.inputs[1] <== derivedSecretField;
    period.inputs[2] <== policyCommitment;
    period.inputs[3] <== periodIndex;
    periodNullifier === period.out;
    component periodBits = Num2Bits(64);
    periodBits.in <== periodIndex;
    component asOfBits = Num2Bits(64);
    asOfBits.in <== asOf;
    // The exact maturity is below 2^113: uint64 index+1, uint32 days,
    // 86400 seconds/day, plus uint64 eligibleFrom. No field wrap is possible.
    component mature = LessEqThan(113);
    mature.in[0] <== eligibleFrom + (periodIndex + 1) * periodDays * 86400;
    mature.in[1] <== asOf;
    mature.out === 1;
    component nextBudget = BudgetNote();
    nextBudget.poolDomain <== scope.domain;
    nextBudget.policyCommitment <== policyCommitment;
    nextBudget.budgetKey <== budgetKey;
    nextBudget.ownerCommitment <== ownerCommitment;
    nextBudget.viewKeyLo <== viewKeyLo;
    nextBudget.viewKeyHi <== viewKeyHi;
    nextBudget.eligibleFrom <== eligibleFrom;
    nextBudget.rate <== rate;
    nextBudget.remaining <== remaining - rate;
    nextBudget.nonce <== outputBudgetNonce;
    nextBudget.ciphertextHash <== ciphertextHashes[0];
    outputCommitments[0] === nextBudget.commitment;
    component valueTag = ShieldedScopedTag();
    valueTag.poolDomain <== scope.domain;
    valueTag.purpose <== 1014;
    component value = ShieldedDonorChange();
    value.valueNoteTag <== valueTag.tag;
    value.ownerCommitment <== ownerCommitment;
    value.amount <== rate;
    value.nonce <== valueNonce;
    value.ciphertextHash <== ciphertextHashes[1];
    outputCommitments[1] === value.noteCommitment;
    component nz[4];
    nz[0] = NonZero(); nz[0].in <== derivedSecretField;
    nz[1] = NonZero(); nz[1].in <== codeSecret;
    nz[2] = NonZero(); nz[2].in <== ownerSecret;
    nz[3] = NonZero(); nz[3].in <== nonce;
}

component main { public [chainId,pool,codeAlias,nonce,ownerCommitment,viewKeyLo,viewKeyHi,policyCommitment,budgetKey,eligibleFrom,asOf,inputRoot,inputNullifier,periodNullifier,outputCommitments,ciphertextHashes,authorizerScope,issuanceRoot,childRoleIndex,endorsementRoleIndex,trustedRoleIndex] } = Claim();
