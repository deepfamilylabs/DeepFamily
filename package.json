{
  "name": "deepfamily",
  "version": "1.0.0",
  "private": true,
  "description": "DeepFamily - Decentralized Digital Family Tree Protocol",
  "main": "index.js",
  "type": "module",
  "workspaces": [
    "frontend",
    "packages/protocol-core"
  ],
  "scripts": {
    "build": "hardhat --config hardhat.config.mjs --build-profile production compile",
    "pages:build": "npm ci --workspace deepfamily-frontend --include-workspace-root=false --no-audit --no-fund && npm run build --workspace deepfamily-frontend",
    "pretest": "npm run test:protocol",
    "test": "cross-env REQUIRE_PROTOCOL_REAL_PROOFS=1 hardhat --config hardhat.config.mjs test mocha",
    "test:protocol": "node scripts/generate-unicode-normalization-data.mjs --check && node scripts/generate-precis-data.mjs --check && npm test --workspace @deepfamily/protocol-core",
    "test:circuits": "node --test circuits/test/*.test.mjs",
    "deploy:net": "hardhat --config hardhat.config.mjs --build-profile production run scripts/deploy-integrated.mjs --network $npm_config_net",
    "deploy:timelock": "hardhat --config hardhat.config.mjs --build-profile production run scripts/deploy-timelock.mjs --network $npm_config_net",
    "acceptance": "node scripts/evm-command.mjs acceptance",
    "mainnet:safe": "node scripts/evm-command.mjs safe",
    "mainnet:release": "node scripts/evm-command.mjs release",
    "mainnet:projection": "node scripts/protocol-deployment-projection.mjs",
    "release:kdf:template": "node scripts/kdf-release-evidence-template.mjs",
    "verify:net": "hardhat --config hardhat.config.mjs --build-profile production verify --network $npm_config_net",
    "check-networks": "hardhat --config hardhat.config.mjs networks:check",
    "list-networks": "hardhat --config hardhat.config.mjs networks:list",
    "clean": "hardhat --config hardhat.config.mjs clean",
    "size": "node scripts/check-contract-size.mjs",
    "bench:revocation": "node scripts/benchmark-revocation-gas.mjs",
    "storage:check": "node scripts/check-storage-layout.mjs",
    "lint": "solhint \"contracts/**/*.sol\"",
    "lint:fix": "solhint \"contracts/**/*.sol\" --fix",
    "contracts:check": "npm run lint && npm run build && npm run size && npm run storage:check && npm test -- --no-compile",
    "format": "prettier --write 'contracts/**/*.sol' 'scripts/**/*.{js,mjs}' 'hardhat/**/*.{js,mjs}' 'tasks/**/*.{js,mjs}' 'circuits/**/*.js' 'packages/**/*.{js,mjs,ts,json}' 'frontend/src/**/*.{ts,tsx,js,jsx,css,md,json}'",
    "prepare": "node scripts/prepare.mjs",
    "frontend:config": "npm run config:local --workspace deepfamily-frontend",
    "frontend:dev": "npm run dev --workspace deepfamily-frontend --",
    "frontend:build": "npm run build --workspace deepfamily-frontend",
    "frontend:preview": "npm run preview --workspace deepfamily-frontend",
    "frontend:lint": "npm run lint --workspace deepfamily-frontend",
    "frontend:source-rules": "npm run source-rules:check --workspace deepfamily-frontend",
    "frontend:typecheck": "tsc --noEmit -p frontend/tsconfig.json",
    "frontend:test": "npm run test --workspace deepfamily-frontend",
    "frontend:check": "npm run frontend:lint && npm run frontend:source-rules && npm run frontend:typecheck && npm run locales:check --workspace deepfamily-frontend && npm run security:xss-scan && npm run frontend:build && npm run frontend:test",
    "check": "npm run test:circuits && npm run contracts:check && npm run frontend:check",
    "security:audit": "node scripts/check-npm-audit.mjs",
    "security:xss-scan": "node scripts/check-xss-sinks.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "dev:node": "hardhat --config hardhat.config.mjs node --hostname 127.0.0.1 --port 8545",
    "dev:deploy": "node scripts/ensure-zk-artifacts.mjs && hardhat --config hardhat.config.mjs run scripts/deploy-integrated.mjs --network localhost",
    "dev:fund": "hardhat --config hardhat.config.mjs run --no-compile scripts/fund-wallet.mjs --network localhost",
    "dev:contract": "npm run dev:deploy && npm run dev:fund && npm run dev:seed",
    "dev:all": "concurrently -k -n node,web -c blue,green \"npm run dev:node\" \"wait-on tcp:127.0.0.1:8545 && npm run dev:contract && npm run frontend:config && npm run frontend:dev -- --host 127.0.0.1 --port 5173\"",
    "dev:seed": "hardhat --config hardhat.config.mjs run scripts/seed-historical.mjs --network localhost",
    "seed:net": "hardhat --config hardhat.config.mjs run scripts/seed-historical.mjs --network $npm_config_net",
    "check:root": "hardhat --config hardhat.config.mjs run scripts/check-root.mjs --network $npm_config_net",
    "zk:fetch": "node scripts/fetch-circom.mjs",
    "zk:ptau:fetch": "node scripts/fetch-ptau.mjs",
    "zk:assets:fetch": "node scripts/fetch-zk-assets.mjs",
    "zk:assets:publish": "node scripts/publish-zk-assets.mjs",
    "zk:build": "node scripts/zk-build.mjs",
    "zk:setup": "node scripts/zk-setup.mjs",
    "zk:check": "node scripts/zk-check.mjs",
    "zk:dev": "node scripts/zk-development.mjs",
    "zk:dev:check": "node scripts/check-zk-artifacts.mjs",
    "test:proof": "cross-env REQUIRE_PROTOCOL_REAL_PROOFS=1 node --test test/protocol-real-proof.test.mjs",
    "test:evm": "cross-env REQUIRE_PROTOCOL_REAL_PROOFS=1 hardhat --config hardhat.config.mjs test mocha test/protocol-real-evm.test.mjs",
    "test:contracts": "hardhat --config hardhat.config.mjs test mocha test/receive-registry.test.mjs test/eligibility-source.test.mjs test/eligibility-lineage.test.mjs test/pool-core.test.mjs test/protocol-deployment.test.mjs",
    "zk:frontend": "node scripts/export-protocol-frontend.mjs"
  },
  "keywords": [
    "blockchain",
    "conflux",
    "espace",
    "evm",
    "ethereum",
    "solidity",
    "nft",
    "genealogy",
    "family-tree",
    "dao",
    "governance"
  ],
  "author": "DeepFamily Team",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.3",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.0",
    "@nomicfoundation/hardhat-mocha": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.3",
    "@nomicfoundation/hardhat-typechain": "^3.0.1",
    "@nomicfoundation/hardhat-verify": "^3.0.8",
    "@openzeppelin/upgrades-core": "^1.44.2",
    "@safe-global/protocol-kit": "8.0.4",
    "@safe-global/safe-deployments": "1.37.60",
    "@safe-global/types-kit": "4.0.1",
    "@typechain/ethers-v6": "^0.5.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": ">=9.1.0",
    "@types/node": ">=18.0.0",
    "@zk-kit/binary-merkle-root.circom": "2.0.0",
    "chai": "^5.1.2",
    "circomlib": "^2.0.5",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "ethers": "^6.17.0",
    "ffjavascript": "0.3.1",
    "hardhat": "^3.12.0",
    "husky": "^9.0.0",
    "keccak256-circom": "git+https://github.com/vocdoni/keccak256-circom.git",
    "lint-staged": "^15.0.0",
    "mocha": "^11.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-solidity": "^1.1.0",
    "snarkjs": "^0.7.4",
    "solhint": "^4.0.0",
    "ts-node": ">=8.0.0",
    "typechain": "^8.3.0",
    "typescript": ">=4.5.0",
    "wait-on": "^7.2.0"
  },
  "lint-staged": {
    "contracts/**/*.sol": [
      "solhint --fix",
      "prettier --write"
    ],
    "{deploy,scripts,test,tasks}/**/*.{js,mjs}": [
      "prettier --write"
    ],
    "packages/**/*.{js,mjs,ts,json}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "bfj": "9.1.3",
    "bn.js": "5.2.3",
    "diff": "8.0.3",
    "elliptic": "6.6.1",
    "serialize-javascript": "7.0.5",
    "underscore": "1.13.8"
  },
  "dependencies": {
    "@deepfamily/protocol-core": "0.1.0",
    "@openzeppelin/contracts": "^5.0.0",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "big-integer": "^1.6.52",
    "dotenv": "^16.0.0",
    "poseidon-lite": "^0.3.0",
    "poseidon-solidity": "^0.0.5"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
