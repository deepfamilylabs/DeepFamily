{
  "name": "deepfamily-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run sync:abi && vite",
    "dev:local": "npm run config:local && npm run dev",
    "build": "npm run sync:abi && vite build && node ./scripts/generate-pages-headers.mjs",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "legacy-entrypoints:check": "node ./scripts/check-legacy-entrypoints.mjs",
    "test": "vitest run",
    "preview": "vite preview",
    "csp:scan": "node ./scripts/csp-scan.mjs",
    "config:local": "node ./scripts/update-local-config.mjs",
    "sync:abi": "node ./scripts/sync-abi.mjs",
    "locales:compare": "node ./scripts/compare-locales.mjs",
    "locales:usage": "node ./scripts/compare-locales.mjs --usage",
    "locales:usage:verbose": "node ./scripts/compare-locales.mjs --verbose-usage",
    "locales:check": "npm run locales:compare && npm run locales:usage"
  },
  "dependencies": {
    "@deepfamily/proof-core": "0.1.0",
    "@hookform/resolvers": "5.2.1",
    "@noble/hashes": "^1.8.0",
    "d3": "^7.9.0",
    "ethers": "^6.17.0",
    "hash-wasm": "^4.12.0",
    "html-to-image": "^1.11.13",
    "i18next": "^25.4.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.540.0",
    "multiformats": "^12.1.3",
    "poseidon-lite": "^0.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.62.0",
    "react-i18next": "^15.7.1",
    "react-router-dom": "^7.18.2",
    "react-window": "^1.8.11",
    "scrypt-js": "^3.0.1",
    "snarkjs": "^0.7.5",
    "zod": "4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/d3": "^7.4.3",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/react-i18next": "^7.8.3",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^29.0.2",
    "playwright-core": "^1.55.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.4.5",
    "vite": "^7.3.0",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "bfj": "9.1.3"
  }
}
