# Frontend environment configuration
# - Local dev: `npm run config:local` generates `frontend/.env.local` from local deployments.
# - Manual: copy this file to `frontend/.env` (or `.env.local`) and fill in values.

# =============================================================================
# REQUIRED
# =============================================================================

# Generated by `npm run config:local`:
# - VITE_RPC_URL
# - VITE_READER_ADDRESS (DeepFamilyReader entry address for the chain above)
# - VITE_READER_ADDRESS_<chainId> (per-chain address book, see below)
# - VITE_ROOT_PERSON_HASH (+ per-language variants)
# - VITE_ROOT_VERSION_INDEX (+ per-language variants)
#
# The app reads person and tree data through the reader, then asks DeepFamily
# for the token. Shielded inheritance also needs the pool factory address below.
# Local redeploys rewrite this file; refresh the app after changing deployments.

VITE_RPC_URL=http://127.0.0.1:8545
VITE_READER_ADDRESS=0x...
VITE_ROOT_PERSON_HASH=0x...
VITE_ROOT_VERSION_INDEX=1

# Host of the browser proving files (WASM/zkey, stored as <sha256>/<file name>). Production
# builds load them from here and `npm run zk:assets:fetch` downloads them from here; Cloudflare
# Pages and CI set it in their own settings. The code names no host and a build without this
# variable fails. Left empty, a local build serves the files from /zk, but downloading them needs
# the real host. The dev server always serves local copies.
VITE_ZK_ASSET_BASE_URL=

# =============================================================================
# OPTIONAL: Multi-language Roots (populated by `npm run config:local`)
# =============================================================================

# VITE_ROOT_PERSON_HASH_EN=0x...
# VITE_ROOT_VERSION_INDEX_EN=1
# VITE_ROOT_PERSON_HASH_ZH=0x...
# VITE_ROOT_VERSION_INDEX_ZH=1

# =============================================================================
# OPTIONAL: Per-chain reader address book
# =============================================================================

# The pair above names ONE deployment, so it only describes the chain
# VITE_RPC_URL points at. These name the reader on other chains, so switching
# networks from the status bar brings the entry contract with it instead of
# leaving the previous chain's address behind. Suffix is the chain id.
#
# This is the only place a built-in network's address comes from: the presets
# in the network menu carry a chain id and an RPC URL, never an address. A
# network with nothing here is listed as "no contract" and reports what it is
# missing when picked, rather than silently reading through some other chain's
# entry contract. The local chain (31337) is the exception: a build that knows no
# reader for it leaves it out of the menu, since only the machine running it
# could ever reach it. Only a custom network supplies its own, and only the dev
# server offers those: a built site's CSP admits no RPC beyond the build's own.
#
# Nothing here is ever cached in the browser — the address is derived from the
# chain on every load — so a redeploy that rewrites these files is picked up on
# the next refresh. `npm run config:local` writes the local one for you.

# VITE_READER_ADDRESS_31337=0x...
# VITE_READER_ADDRESS_71=0x...
# VITE_READER_ADDRESS_1030=0x...

# =============================================================================
# REQUIRED FOR THE SHIELDED INHERITANCE PAGE
# =============================================================================

# The factory is an immutable module separate from DeepFamily and resolves the
# pool for each asset. The event-start block lets each browser rebuild the public
# note tree from its first append. Local deployment writes all values through
# `npm run config:local`.
# VITE_SHIELDED_POOL_FACTORY_ADDRESS=0x...
# VITE_SHIELDED_POOL_FACTORY_ADDRESS_31337=0x...
# VITE_SHIELDED_POOL_FACTORY_FROM_BLOCK=0
# VITE_SHIELDED_POOL_FACTORY_FROM_BLOCK_31337=0

# =============================================================================
# OPTIONAL: Performance (tune down for public RPCs)
# =============================================================================

# VITE_DF_HARD_NODE_LIMIT=10000
# VITE_DF_EDGE_TTL_MS=120000
# VITE_DF_TV_TTL_MS=60000
# VITE_DF_VD_TTL_MS=300000
# VITE_DF_NFT_TTL_MS=86400000
# VITE_DF_STORY_TTL_MS=300000
# VITE_DF_QUERY_PAGE_LIMIT=200

# Account (wallet address) search scans PersonVersionAdded logs, because the
# contract has no reverse index by creator. Set FROM_BLOCK to the deployment
# block so the backward scan terminates instead of walking towards genesis;
# lower BLOCK_CHUNK if your RPC caps eth_getLogs ranges (10k is a common cap).
# The inheritance page replays every lineage-index and endorsement event from
# FROM_BLOCK, with no chunk limit, so FROM_BLOCK also bounds how long an
# inheritance search takes.
# VITE_DF_EVENT_FROM_BLOCK=0
# VITE_DF_EVENT_BLOCK_CHUNK=10000
# VITE_DF_EVENT_MAX_CHUNKS=50
# VITE_DF_EVENT_MAX_RESULTS=1000
# VITE_USE_INDEXEDDB_CACHE=1
# VITE_USE_FLAT_TREE=0

# =============================================================================
# OPTIONAL: Debug
# =============================================================================

# VITE_SHOW_DEBUG=1
# VITE_SHOW_DEDUPLICATE_TOGGLE=1
# VITE_SHOW_NODE_MODE_TOGGLE=1
# Trusted-source filter toggle is shown by default (on); set to 0 to hide it and force filtering always-on.
# VITE_SHOW_TRUSTED_SOURCE_FILTER_TOGGLE=0

# =============================================================================
# OPTIONAL: CSP (Vite Server/Preview; read by `vite.config.ts`, server-side only)
# =============================================================================

# Write CSP violation reports to this file (JSONL). Defaults to `.csp-scan/report.<mode>.jsonl` during `npm run csp:scan`.
# DEEP_CSP_REPORT_FILE=

# Add extra allowed origins: space-separated origins only, anything else fails the build.
# Example: DEEP_CSP_CONNECT_SRC="https://rpc.ankr.com https://*.infura.io"
# Note: `connect-src` already includes the origin of `VITE_RPC_URL` automatically.
# DEEP_CSP_CONNECT_SRC=
# Example: DEEP_CSP_IMG_SRC="https://images.example.org"
# DEEP_CSP_IMG_SRC=

# Auto-include built-in RPC origins (from `src/shared/config/networks.ts`). The local chain is
# included only when the build names its reader (VITE_READER_ADDRESS_31337).
# DEEP_CSP_INCLUDE_NETWORK_PRESETS=0
