# Copy to .env; never commit .env, private keys, owner signatures, or recovery evidence.
# Workflow order: Testnet acceptance -> Mainnet Safe -> owner acceptance -> protocol release.
# This template uses eSpace policy and budget examples; review them before any ethereum:* command.

# 1. Network access and active transaction signer

# Testnet acceptance: use a funded Testnet base signer.
# Mainnet plan/status are read-only; execute requires the key matching
# EVM_MAINNET_EXPECTED_DEPLOYER.
# Never use a Safe owner key here.
PRIVATE_KEY=

# Blank eSpace URLs use official public RPCs; production should use a reviewed, monitored RPC.
CONFLUX_TESTNET_RPC_URL=
CONFLUX_RPC_URL=

# Ethereum only: explicit URLs override the INFURA_API_KEY fallback.
ETHEREUM_SEPOLIA_RPC_URL=
ETHEREUM_MAINNET_RPC_URL=
INFURA_API_KEY=

# Blank is accepted by ConfluxScan, unused on Sepolia, and invalid for Ethereum Mainnet execution.
EXPLORER_API_KEY=

# 2. Testnet acceptance and shared production policy

# diagnostic exercises the governance lifecycle. Before release, run release-rehearsal from its
# clean commit.
EVM_E2E_MODE=diagnostic

# Optional production Powers of Tau override; normally leave blank to use the pinned cache.
ZK_PTAU_PATH=

# Canonical Safe policy; this must match the selected command family:
# espace:* -> conflux-safe-1.3.0-2of3; ethereum:* -> ethereum-safe-1.3.0-2of3
GOVERNANCE_SAFE_PROFILE=conflux-safe-1.3.0-2of3

# Fresh Timelock delay: 172800 = 48 hours; production minimum is 86400.
# release-rehearsal uses this value; diagnostic defaults to 30 seconds.
MIN_DELAY=172800

# 3. Mainnet Safe plan and deployment

# Public address derived from the deployer PRIVATE_KEY used by Mainnet execute commands.
EVM_MAINNET_EXPECTED_DEPLOYER=

# Exactly three distinct ordered public owner addresses, separated by ASCII commas.
# Never put owner private keys here.
EVM_MAINNET_SAFE_OWNERS=

# Locally chosen decimal uint256; owner order plus this nonce determines the Safe address.
EVM_MAINNET_SAFE_SALT_NONCE=20260810

# Explicit Safe factory-call hard ceiling, not a spending target; eSpace example: 0.2 CFX.
EVM_MAINNET_SAFE_MAX_NATIVE=0.2

# Mainnet Safe deployment/status and protocol release default to 2 confirmations and a
# 3600-second finality timeout.

# 4. External Safe owner acceptance and the production governance Safe

# Leave blank until the deployed Safe's first execution is the documented 0-value smoke call.
# After two real owners approve it and the Safe executes it, record the outer hash, then run
# safe:status.
EVM_MAINNET_SAFE_ACCEPTANCE_TX=

# Exact deployed production Safe Proxy address, not an owner EOA, singleton, or factory.
# The release gives this Safe exclusive proposer/canceller/executor roles on the new Timelock;
# the Timelock, not the Safe, becomes the protocol owner. Leave blank through Safe deployment and
# fill it with the deployed Safe address only after safe:status prints governance ready: yes.
GOVERNANCE_SAFE_ADDRESS=

# 5. Fresh protocol release

# No Timelock address is configured for a fresh release: the orchestrator deploys and checkpoints
# GovernanceTimelock. Later manual/reuse operations use GOVERNANCE_TIMELOCK_ADDRESS temporarily.

# Explicit cumulative release hard ceiling, not a spending target; eSpace example: 5 CFX.
EVM_MAINNET_MAX_NATIVE=5

# Successful release-rehearsal publishes evidence automatically to its fixed chain-specific path.
# Protocol approval and exceptional recovery are one-shot JSON-file inputs, not .env settings.

# 6. Local development and optional seed data

# Applies only to Hardhat's local simulated networks; never relaxes a live-chain size limit.
UNLIMITED_SIZE=true

# Comma-separated files under data/persons/. A limit <= 0 processes every member.
HISTORICAL_DATA_FILES=en-kennedy-family.json,zh-cao-family.json
HISTORICAL_SEED_LIMIT=0
