# Copy to .env and never commit real secrets.

# Signer and governance
# PRIVATE_KEY pays gas and must not belong to a Safe owner.
PRIVATE_KEY=
GOVERNANCE_MULTISIG=
# Keep blank for a fresh release.
GOVERNANCE_OWNER=
MIN_DELAY=
# espace:* -> conflux-safe-1.3.0-2of3; ethereum:* -> ethereum-safe-1.3.0-2of3
GOVERNANCE_MULTISIG_PROFILE=conflux-safe-1.3.0-2of3

# RPC
# Explicit Ethereum URLs override the INFURA_API_KEY fallback.
INFURA_API_KEY=
ETHEREUM_SEPOLIA_RPC_URL=
ETHEREUM_MAINNET_RPC_URL=
# Blank values use the official Conflux public endpoints.
CONFLUX_TESTNET_RPC_URL=
CONFLUX_RPC_URL=

# Contract verification: optional for ConfluxScan, unused on Sepolia, required on Ethereum Mainnet.
EXPLORER_API_KEY=

# Optional pinned production Powers of Tau override.
ZK_PTAU_PATH=

# Shared EVM testnet acceptance
# The command selects eSpace Testnet (71) or Sepolia (11155111).
# Set only for an intentional run: conflux-testnet-chain-71 or ethereum-sepolia-chain-11155111.
EVM_E2E_CONFIRM=
EVM_E2E_MODE=diagnostic
EVM_E2E_MIN_DELAY=30
EVM_E2E_CONFIRMATIONS=2
# Blank uses the selected profile default: 5 CFX or 0.2 ETH.
EVM_E2E_MAX_NATIVE=
EVM_E2E_RUN_ID=
# Recovery requires the exact RUN_ID from the selected chain's report.
EVM_E2E_RECOVER=0
EVM_E2E_VERIFY=1
EVM_E2E_REQUIRE_FINALITY=1
EVM_E2E_FINALITY_TIMEOUT=3600

# Shared EVM Mainnet settings
# espace:mainnet:* selects eSpace Mainnet/CFX; ethereum:mainnet:* selects Ethereum Mainnet/ETH.
# Keep authorization, evidence and budgets blank in persistent config; never reuse them across chains.
EVM_MAINNET_CONFIRMATIONS=2
EVM_MAINNET_FINALITY_TIMEOUT=3600
EVM_MAINNET_EXPECTED_DEPLOYER=
# Exactly three ordered public owner addresses; never put owner keys here.
EVM_MAINNET_SAFE_OWNERS=

# Safe bootstrap
EVM_MAINNET_SAFE_SALT_NONCE=
# Required per plan/execution; unit is selected by the command.
EVM_MAINNET_SAFE_MAX_NATIVE=
# Blank pair is plan mode. Execute uses the printed digest and chain-specific confirmation string.
EVM_MAINNET_SAFE_CONFIRM=
EVM_MAINNET_SAFE_PLAN_DIGEST=
EVM_MAINNET_SAFE_RECOVERY_TX=
# Outer hash of the documented zero-value Safe smoke transaction.
EVM_MAINNET_SAFE_ACCEPTANCE_TX=

# Protocol release
# Blank pair is plan mode. Execute uses the printed digest and chain-specific confirmation string.
EVM_MAINNET_CONFIRM=
EVM_MAINNET_PLAN_DIGEST=
# JSON array with signatures from at least two reviewed Safe owners.
EVM_MAINNET_PLAN_APPROVAL_SIGNATURES=
# Required per plan/execution; separate from the Safe bootstrap budget.
EVM_MAINNET_MAX_NATIVE=
# Selected testnet's schema-v3 release-rehearsal report.
EVM_MAINNET_TESTNET_RELEASE_REPORT=
# JSON object mapping exact runner labels to recovery transaction hashes.
EVM_MAINNET_RECOVERY_TXS=

# Build / local network
UNLIMITED_SIZE=true

# Gas report
COINMARKETCAP_API_KEY=
REPORT_GAS=

# CI
CONTRACT_SIZER_STRICT=false

# Seed data
HISTORICAL_DATA_FILES=en-kennedy-family.json,zh-cao-family.json
# <= 0 means no limit.
HISTORICAL_SEED_LIMIT=0
