# Copy this file to the project root and rename it to .env before use

# Approved production deployer/relayer private key with 0x prefix (DO NOT commit).
# It pays for the Safe factory call and protocol deployment. It must not be a Safe-owner key.
PRIVATE_KEY=

# Production governance. Leave GOVERNANCE_MULTISIG blank until the Safe creator has deployed and
# verified it; then copy the reviewed address here. Fresh release keeps GOVERNANCE_OWNER blank
# because the release runner deploys the GovernanceTimelock and transfers ownership to it.
GOVERNANCE_MULTISIG=
GOVERNANCE_OWNER=
MIN_DELAY=
# Select the profile that matches the command family being run:
# - espace:*    -> conflux-safe-1.3.0-2of3
# - ethereum:*  -> ethereum-safe-1.3.0-2of3
GOVERNANCE_MULTISIG_PROFILE=conflux-safe-1.3.0-2of3

# Ethereum RPC. Explicit URLs take precedence; blank URLs fall back to INFURA_API_KEY.
INFURA_API_KEY=
ETHEREUM_SEPOLIA_RPC_URL=
ETHEREUM_MAINNET_RPC_URL=

# Conflux eSpace RPC overrides (blank values use the official public endpoints)
CONFLUX_TESTNET_RPC_URL=
CONFLUX_RPC_URL=

# Optional public production ZK Phase 1 override (not a secret). Leave blank to use the exact
# size/SHA-256/BLAKE2b-512-pinned cache downloaded by `npm run zk:production:setup` or
# `npm run zk:ptau:fetch`. A nonblank value must identify that same reviewed file.
ZK_PTAU_PATH=

# Shared public production identities (Conflux eSpace Mainnet, chain ID 1030 only).
# Approved deployer/relayer EOA. Both runners reject a PRIVATE_KEY with another address.
ESPACE_MAINNET_EXPECTED_DEPLOYER=
# Exactly three distinct EOA/hardware-wallet owner addresses, in the final reviewed order.
# Owner order is part of Safe setup, address prediction and the plan digest; never reorder it after
# generating a Safe plan. Only public addresses belong here—never owner private keys or seed words.
ESPACE_MAINNET_SAFE_OWNERS=

# Canonical Safe v1.3.0 2-of-3 bootstrap.
# Explicit decimal uint256 used in deterministic Safe address prediction. Choose once and keep it
# unchanged for plan, execute and recovery.
ESPACE_MAINNET_SAFE_SALT_NONCE=
# Safe factory-call-only budget. This is separate from the 14-transaction protocol release budget.
ESPACE_MAINNET_SAFE_MAX_CFX=
ESPACE_MAINNET_SAFE_CONFIRMATIONS=2
ESPACE_MAINNET_SAFE_FINALITY_TIMEOUT=3600
# Blank pair = read-only plan. After review, set the printed digest and exact confirmation string
# conflux-mainnet-safe-chain-1030 to deploy or resume the single factory call.
ESPACE_MAINNET_SAFE_CONFIRM=
ESPACE_MAINNET_SAFE_PLAN_DIGEST=
# Only for a factory transaction broadcast after its planned checkpoint but before hash persistence.
ESPACE_MAINNET_SAFE_RECOVERY_TX=
# After deployment, two real owners must execute the documented refund-free 0 CFX / empty-calldata
# CALL to ESPACE_MAINNET_EXPECTED_DEPLOYER. Put its outer transaction hash here. Protocol release
# requires this to be the Safe's first and only execution at release-plan time.
ESPACE_MAINNET_SAFE_ACCEPTANCE_TX=

# Protocol release orchestrator (chain ID 1030 only).
# Blank pair = read-only plan. After review, set the exact printed digest and confirmation string
# conflux-mainnet-chain-1030 to execute or resume.
ESPACE_MAINNET_CONFIRM=
ESPACE_MAINNET_PLAN_DIGEST=
# Execute only: JSON array containing EIP-191 signatures of the exact printed plan-approval
# message from at least two current ESPACE_MAINNET_SAFE_OWNERS. Keep blank while planning.
# The release runner verifies recovered owners and never reads their private keys.
ESPACE_MAINNET_PLAN_APPROVAL_SIGNATURES=
# Required plan/execution budget ceiling in CFX. The deployer balance must cover it at execution.
ESPACE_MAINNET_MAX_CFX=
# Receipt confirmations per transaction before the runner advances (minimum 2 in production).
ESPACE_MAINNET_CONFIRMATIONS=2
# Maximum seconds to wait for the finalized head to cover every release transaction.
ESPACE_MAINNET_FINALITY_TIMEOUT=3600
# Exact schema-v3 eSpace Testnet release-rehearsal report from this clean commit and MIN_DELAY.
# Diagnostic reports and reports with releaseReady=false are rejected.
ESPACE_MAINNET_TESTNET_RELEASE_REPORT=
# Optional recovery evidence for a transaction broadcast before its checkpoint was persisted.
# Use one-line JSON mapping the runner's exact transaction label to its 0x-prefixed hash.
ESPACE_MAINNET_RECOVERY_TXS=
# Mainnet execution always enforces source verification, finalized coverage, the
# conflux-safe-1.3.0-2of3 profile, and MIN_DELAY >= 86400; none can be disabled by environment.

# Destructive Conflux eSpace Testnet acceptance run (never configure this for mainnet).
# Set exactly to conflux-testnet-chain-71 before running; the script also checks network name and
# chain ID 71. Keeping it blank prevents an accidental write-on-chain run after copying this file.
ESPACE_E2E_CONFIRM=
# Run classification. "diagnostic" is the safe default and can never produce releaseReady=true.
# Use "release-rehearsal" only from a clean release checkout; it forces verification and finality,
# requires MIN_DELAY=ESPACE_E2E_MIN_DELAY, and requires the strict conflux-safe-1.3.0-2of3 profile.
ESPACE_E2E_MODE=diagnostic
# Timelock delay exercised by the eSpace testnet runner (minimum 10 seconds, no artificial maximum).
# Keep 30 only for development diagnostics. A release rehearsal should use the exact planned
# production MIN_DELAY (for example 172800), even though the unattended run will take longer.
ESPACE_E2E_MIN_DELAY=30
# Number of block confirmations required after each acceptance transaction; accepted range is 1-100.
ESPACE_E2E_CONFIRMATIONS=2
# Maximum test CFX transferred to the isolated per-run deployer (and therefore its hard spend cap).
ESPACE_E2E_MAX_CFX=5
# Normally blank: the runner creates a run ID. An explicit ID must be 8-80 characters using only
# letters, digits, underscore, or hyphen. For interrupted-funds recovery, copy the exact ID from
# the report, set ESPACE_E2E_RECOVER=1, and run the same espace:acceptance command.
ESPACE_E2E_RUN_ID=
# Normal mode is 0; set to 1 only when recovering an interrupted run's remaining test CFX.
ESPACE_E2E_RECOVER=0
# ConfluxScan verification is enabled by default. Set to 0 only for protocol-only diagnostics;
# release-rehearsal rejects 0 and the report will otherwise mark verification as skipped.
ESPACE_E2E_VERIFY=1
# A complete rehearsal waits until the chain's finalized block covers every critical transaction.
# Set to 0 only for diagnostics; release-rehearsal rejects 0.
ESPACE_E2E_REQUIRE_FINALITY=1
# Maximum seconds to wait for the finalized tag to cover the last critical transaction.
ESPACE_E2E_FINALITY_TIMEOUT=3600

# Destructive Ethereum Sepolia acceptance run (never configure this for mainnet).
# This is the Ethereum equivalent of espace:acceptance and uses a separate authorization,
# wallet-derivation domain, budget, report directory and recovery state.
ETHEREUM_E2E_CONFIRM=
ETHEREUM_E2E_MODE=diagnostic
ETHEREUM_E2E_MIN_DELAY=30
ETHEREUM_E2E_CONFIRMATIONS=2
ETHEREUM_E2E_MAX_ETH=5
ETHEREUM_E2E_RUN_ID=
ETHEREUM_E2E_RECOVER=0
ETHEREUM_E2E_VERIFY=1
ETHEREUM_E2E_REQUIRE_FINALITY=1
ETHEREUM_E2E_FINALITY_TIMEOUT=3600
# Set ETHEREUM_E2E_CONFIRM exactly to ethereum-sepolia-chain-11155111 before:
#   npm run ethereum:acceptance
# release-rehearsal also requires MIN_DELAY=ETHEREUM_E2E_MIN_DELAY and
# GOVERNANCE_MULTISIG_PROFILE=ethereum-safe-1.3.0-2of3.

# Ethereum Mainnet public production identities (chain ID 1 only).
ETHEREUM_MAINNET_EXPECTED_DEPLOYER=
ETHEREUM_MAINNET_SAFE_OWNERS=

# Canonical Safe v1.3.0 L1 2-of-3 bootstrap on Ethereum Mainnet.
ETHEREUM_MAINNET_SAFE_SALT_NONCE=
ETHEREUM_MAINNET_SAFE_MAX_ETH=
ETHEREUM_MAINNET_SAFE_CONFIRMATIONS=2
ETHEREUM_MAINNET_SAFE_FINALITY_TIMEOUT=3600
# Blank pair = read-only plan. Execute requires the printed digest and exact confirmation
# ethereum-mainnet-safe-chain-1.
ETHEREUM_MAINNET_SAFE_CONFIRM=
ETHEREUM_MAINNET_SAFE_PLAN_DIGEST=
ETHEREUM_MAINNET_SAFE_RECOVERY_TX=
ETHEREUM_MAINNET_SAFE_ACCEPTANCE_TX=

# Ethereum Mainnet protocol release. Blank confirmation/digest keeps the command read-only.
ETHEREUM_MAINNET_CONFIRM=
ETHEREUM_MAINNET_PLAN_DIGEST=
# Execute only: JSON array of at least two current Safe-owner EIP-191 signatures over the exact
# plan-approval message printed by the read-only plan.
ETHEREUM_MAINNET_PLAN_APPROVAL_SIGNATURES=
ETHEREUM_MAINNET_MAX_ETH=
ETHEREUM_MAINNET_CONFIRMATIONS=2
ETHEREUM_MAINNET_FINALITY_TIMEOUT=3600
# Exact schema-v3 Sepolia release-rehearsal report from this clean commit and MIN_DELAY.
ETHEREUM_MAINNET_TESTNET_RELEASE_REPORT=
ETHEREUM_MAINNET_RECOVERY_TXS=
# Execution requires ETHEREUM_MAINNET_CONFIRM=ethereum-mainnet-chain-1, the reviewed digest,
# GOVERNANCE_MULTISIG_PROFILE=ethereum-safe-1.3.0-2of3 and a real EXPLORER_API_KEY.

# Contract verification key for the network selected by the current verify command.
# ConfluxScan: optional; a blank value automatically uses the non-secret placeholder "espace".
# Ethereum Sepolia: not used; acceptance and manual verification use API-key-free Blockscout.
# Ethereum Mainnet: required; set a real Etherscan API key before release verification.
EXPLORER_API_KEY=

# Build / Local network settings
# The Solidity EVM target is fixed to Cancun in hardhat.config.mjs because the contracts use
# EIP-1153 transient storage; it is intentionally not environment-configurable.
# Local Hardhat networks only; this does not change live-network contract-size limits.
UNLIMITED_SIZE=true

# Gas report
COINMARKETCAP_API_KEY=
REPORT_GAS=

# CI controls
CONTRACT_SIZER_STRICT=false

# Seeding data files (comma-separated)
HISTORICAL_DATA_FILES=en-kennedy-family.json,zh-cao-family.json
# Limit number of members processed per file (optional, <=0 means no limit)
HISTORICAL_SEED_LIMIT=0
